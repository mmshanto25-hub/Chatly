rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own user profile, and read other user profiles
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['storyNoteViewedBy', 'storyNoteLovedBy', 'profileVisitorsCount'])
      );

      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null &&
          request.resource.data.actorId == request.auth.uid &&
          request.resource.data.createdAt is int &&
          (
            (
              request.resource.data.type in ['story_comment', 'story_comment_reply', 'story_mention'] &&
              request.resource.data.storyId is string &&
              request.resource.data.commentId is string &&
              get(/databases/$(database)/documents/stories/$(request.resource.data.storyId)/comments/$(request.resource.data.commentId)).data.senderId == request.auth.uid &&
              (
                get(/databases/$(database)/documents/stories/$(request.resource.data.storyId)).data.userId == userId ||
                userId in get(/databases/$(database)/documents/stories/$(request.resource.data.storyId)/comments/$(request.resource.data.commentId)).data.get('mentionIds', []) ||
                (
                  request.resource.data.recipientCommentId is string &&
                  request.resource.data.recipientCommentId.size() > 0 &&
                  get(/databases/$(database)/documents/stories/$(request.resource.data.storyId)/comments/$(request.resource.data.recipientCommentId)).data.senderId == userId
                )
              )
            ) ||
            (
              request.resource.data.type == 'comment_love' &&
              request.resource.data.storyId is string &&
              request.resource.data.commentId is string &&
              get(/databases/$(database)/documents/stories/$(request.resource.data.storyId)/comments/$(request.resource.data.commentId)).data.senderId == userId &&
              request.auth.uid in get(/databases/$(database)/documents/stories/$(request.resource.data.storyId)/comments/$(request.resource.data.commentId)).data.lovedBy
            ) ||
            (
              request.resource.data.type == 'message' &&
              request.resource.data.conversationId is string &&
              userId in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participantIds &&
              request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participantIds
            )
          );
        allow update: if request.auth != null &&
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) &&
          request.resource.data.isRead is bool;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /fcmTokens/{tokenId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Stories are visible to signed-in users and manageable only by their owner.
    match /stories/{storyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['viewedBy', 'lovedBy']) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['viewedBy']) ||
            (
              request.resource.data.get('viewedBy', []).toSet()
                .difference(resource.data.get('viewedBy', []).toSet())
                .hasOnly([request.auth.uid]) &&
              resource.data.get('viewedBy', []).toSet()
                .difference(request.resource.data.get('viewedBy', []).toSet())
                .hasOnly([])
            )
          ) &&
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lovedBy']) ||
            (
              request.resource.data.get('lovedBy', []).toSet()
                .difference(resource.data.get('lovedBy', []).toSet())
                .hasOnly([request.auth.uid]) &&
              resource.data.get('lovedBy', []).toSet()
                .difference(request.resource.data.get('lovedBy', []).toSet())
                .hasOnly([request.auth.uid])
            )
          )
        )
      );
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.userId;

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.parentCommentId is string &&
          request.resource.data.mentionIds is list;
        allow update: if request.auth != null && (
          request.auth.uid == resource.data.senderId ||
          request.auth.uid == get(/databases/$(database)/documents/stories/$(storyId)).data.userId ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lovedBy']) &&
            request.resource.data.get('lovedBy', []).toSet()
              .difference(resource.data.get('lovedBy', []).toSet())
              .hasOnly([request.auth.uid]) &&
            resource.data.get('lovedBy', []).toSet()
              .difference(request.resource.data.get('lovedBy', []).toSet())
              .hasOnly([request.auth.uid])
          )
        );
        allow delete: if request.auth != null && (
          request.auth.uid == resource.data.senderId ||
          request.auth.uid == get(/databases/$(database)/documents/stories/$(storyId)).data.userId
        );
      }
    }

    // Conversations can be read/written by participants
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null && request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participantIds;

      // Messages inside conversations
      match /messages/{messageId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
      }
    }
  }
}
